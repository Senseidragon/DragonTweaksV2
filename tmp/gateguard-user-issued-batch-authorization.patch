## 2. New Functions — insert after the `saveState` function definition

```javascript
// ─────────────────────────────────────────────────────────────────────────────
// BATCH AUTHORIZATION — user-issued, transcript-scoped
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Convert a simple glob (docs/foo/* or docs/foo/**) to a RegExp.
 * Rejects patterns containing `..`, shell metacharacters, or absolute paths.
 * Returns null if the pattern is unsafe or unsupported.
 */
function globToRegex(glob) {
  if (!glob || typeof glob !== 'string') return null;
  if (/\.\./.test(glob)) return null;
  if (/[;|&$`(){}[\]!]/.test(glob)) return null;
  if (/^\//.test(glob)) return null;

  const escaped = glob
    .replace(/[.+^${}()|[\]\\]/g, '\\$&')
    .replace(/\*\*/g, '\u0001')
    .replace(/\*/g, '[^/]*')
    .replace(/\u0001/g, '.*')
    .replace(/\?/g, '[^/]');

  try {
    return new RegExp('^' + escaped + '$');
  } catch (e) {
    return null;
  }
}

/**
 * Normalize a file path to project-relative form.
 * Returns null if the path escapes the project directory (traversal attempt).
 */
function normalizePathForMatch(filePath, projectDir) {
  if (!filePath || !projectDir) return null;
  const path = require('path');
  const abs = path.resolve(filePath);
  const base = path.resolve(projectDir);
  if (!abs.startsWith(base + path.sep) && abs !== base) return null;
  return abs.slice(base.length + 1).replace(/\\/g, '/');
}

/**
 * Parse a single GATEGUARD-BATCH-AUTH directive line.
 * Returns a structured auth object or null if invalid.
 *
 * Expected format (all on one line, fields space-separated):
 *   GATEGUARD-BATCH-AUTH: glob=X ops=Write,Edit ext=.md max=20 ttl=3600 risk=label
 */
function parseBatchAuthLine(line) {
  const PREFIX = 'GATEGUARD-BATCH-AUTH:';
  const idx = line.indexOf(PREFIX);
  if (idx === -1) return null;
  const directive = line.slice(idx + PREFIX.length).trim();

  const fields = {};
  for (const token of directive.split(/\s+/)) {
    const eq = token.indexOf('=');
    if (eq === -1) continue;
    const k = token.slice(0, eq).trim();
    const v = token.slice(eq + 1).trim();
    fields[k] = v;
  }

  if (!fields.glob) return null;

  const pattern = globToRegex(fields.glob);
  if (!pattern) return null;

  const ops = fields.ops
    ? fields.ops.split(',').map(s => s.trim()).filter(Boolean)
    : ['Write', 'Edit'];

  const ext = fields.ext || null;
  if (ext && !ext.startsWith('.')) return null;

  const max = fields.max ? parseInt(fields.max, 10) : 50;
  if (isNaN(max) || max < 1 || max > 200) return null;

  const ttl = fields.ttl ? parseInt(fields.ttl, 10) : 3600;
  if (isNaN(ttl) || ttl < 1) return null;

  const risk = fields.risk || 'unspecified';

  return { glob: fields.glob, pattern, ops, ext, max, ttl, risk, issuedAt: Date.now() };
}

/**
 * Read the session transcript JSONL and extract all batch authorizations
 * issued by the user (role: "user" entries only — assistant entries ignored).
 * Returns an array of parsed auth objects (may be empty).
 */
function loadUserBatchAuthorizations(transcriptPath, projectDir) {
  if (!transcriptPath) return [];
  const fs = require('fs');
  let lines;
  try {
    lines = fs.readFileSync(transcriptPath, 'utf8').split('\n');
  } catch (e) {
    return [];
  }

  const results = [];

  for (const raw of lines) {
    const trimmed = raw.trim();
    if (!trimmed) continue;
    let entry;
    try { entry = JSON.parse(trimmed); } catch (e) { continue; }

    // Only honor directives from the human side of the conversation.
    // Claude's output appears as role:"assistant" and is ignored here.
    if (!entry || entry.role !== 'user') continue;

    let text = '';
    if (typeof entry.content === 'string') {
      text = entry.content;
    } else if (Array.isArray(entry.content)) {
      text = entry.content
        .filter(c => c && c.type === 'text')
        .map(c => c.text || '')
        .join('\n');
    }

    if (!text.includes('GATEGUARD-BATCH-AUTH:')) continue;

    for (const line of text.split('\n')) {
      const auth = parseBatchAuthLine(line);
      if (auth) results.push(auth);
    }
  }

  return results;
}

/**
 * Check if filePath + toolName match any active batch authorization.
 * Returns the matching auth object or null.
 */
function findMatchingBatchAuth(filePath, toolName, authorizations, projectDir) {
  if (!authorizations || authorizations.length === 0) return null;
  const path = require('path');
  const rel = normalizePathForMatch(filePath, projectDir);
  if (!rel) return null;

  const ext = path.extname(filePath).toLowerCase();

  for (const auth of authorizations) {
    if (!auth.ops.includes(toolName)) continue;
    if (auth.ext && ext !== auth.ext.toLowerCase()) continue;
    if (!auth.pattern.test(rel)) continue;
    return auth;
  }
  return null;
}

// Usage counters stored in state under `batch_auth_counts`.
// Key format: glob + '|' + ext (or 'any') + '|' + ops.sort().join(',')

function batchAuthCountKey(auth) {
  const ext = auth.ext || 'any';
  const ops = [...auth.ops].sort().join(',');
  return auth.glob + '|' + ext + '|' + ops;
}

function getBatchAuthCount(state, auth) {
  const counts = state.batch_auth_counts || {};
  return counts[batchAuthCountKey(auth)] || 0;
}

function incrementBatchAuthCount(state, auth) {
  if (!state.batch_auth_counts) state.batch_auth_counts = {};
  const key = batchAuthCountKey(auth);
  state.batch_auth_counts[key] = (state.batch_auth_counts[key] || 0) + 1;
}
```

