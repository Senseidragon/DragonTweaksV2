## 4. Modified Write/Edit gate — insert batch-auth check before the deny

Find this block (anchor on the `if (toolName === 'Edit' || toolName === 'Write')` line):

```javascript
// EXISTING BLOCK:
if (toolName === 'Edit' || toolName === 'Write') {
  const filePath = toolInput.file_path || '';
  if (!filePath || isClaudeSettingsPath(filePath)) {
    return rawInput; // allow
  }
  if (inSubagent) {
    return rawInput; // parent session already passed the first-touch file gate
  }
  if (!isChecked(filePath)) {
    if (!markChecked(filePath)) {
      return allowWithStateWarning();
    }
    return denyResult(toolName === 'Edit' ? editGateMsg(filePath) : writeGateMsg(filePath));
  }
  return rawInput; // allow
}
```

Replace with:

```javascript
// REPLACEMENT BLOCK:
if (toolName === 'Edit' || toolName === 'Write') {
  const filePath = toolInput.file_path || '';
  if (!filePath || isClaudeSettingsPath(filePath)) {
    return rawInput; // allow
  }
  if (inSubagent) {
    return rawInput; // parent session already passed the first-touch file gate
  }
  if (!isChecked(filePath)) {
    // ── Batch authorization check ────────────────────────────────────────
    // Only role:"user" JSONL entries are read. Claude's output is
    // role:"assistant" and is silently ignored — Claude cannot self-authorize.
    const transcriptPath = process.env.CLAUDE_TRANSCRIPT_PATH || '';
    const projectDir = process.env.CLAUDE_PROJECT_DIR || process.cwd();
    const batchAuths = loadUserBatchAuthorizations(transcriptPath, projectDir);
    const matchedAuth = findMatchingBatchAuth(filePath, toolName, batchAuths, projectDir);

    if (matchedAuth) {
      const state = loadState();
      const used = getBatchAuthCount(state, matchedAuth);
      if (used < matchedAuth.max) {
        if (!markChecked(filePath)) {
          return allowWithStateWarning();
        }
        incrementBatchAuthCount(state, matchedAuth);
        saveState(state);
        return rawInput; // authorized by batch directive — no gate loop
      }
      // Over the limit: fall through to normal gate
    }
    // ── End batch authorization check ────────────────────────────────────

    if (!markChecked(filePath)) {
      return allowWithStateWarning();
    }
    return denyResult(toolName === 'Edit' ? editGateMsg(filePath) : writeGateMsg(filePath));
  }
  return rawInput; // allow
}
```

